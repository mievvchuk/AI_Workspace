# Copy to backend/.env and fill in.

# NVIDIA NIM (OpenAI-compatible). Get a key at build.nvidia.com
NVIDIA_API_KEY=
DEFAULT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# AI_PROVIDER=mock   # only for local demos/tests: the UI labels it as a test provider

# Google OAuth (optional). Authorized redirect URI in Google Cloud Console:
#   http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origins: the browser talks to the API through the Vite proxy in dev (same origin).
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173
COOKIE_SECURE=false

USER_DAILY_TOKEN_LIMIT=500000
MAX_UPLOAD_MB=20
AI_EVENT_RETENTION_DAYS=30
